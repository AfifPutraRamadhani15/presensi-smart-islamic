# ===== SUPABASE (server-only, JANGAN pakai prefix NEXT_PUBLIC) =====
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=isi-service-role-key

# ===== KEAMANAN (buat dengan: npm run gen-keys) =====
SESSION_SECRET=isi-string-acak-minimal-32-karakter
FACE_ENC_KEY=isi-64-karakter-hex

# ===== SEED ADMIN PERTAMA (dipakai oleh: npm run seed-admin) =====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiPasswordIni#2026

# ===== WHATSAPP CLOUD API (opsional; kosong = mode SIMULASI) =====
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Jika diisi, pesan dikirim sebagai TEMPLATE yang sudah disetujui Meta
# (parameter body berurutan: nama, nis, kelas, kegiatan, tanggal, waktu, status)
WA_TEMPLATE_NAME=
WA_TEMPLATE_LANG=id

# ===== AI CHATBOT (opsional; kosong = chatbot berbasis aturan) =====
AI_API_KEY=
AI_MODEL=claude-sonnet-5-5
